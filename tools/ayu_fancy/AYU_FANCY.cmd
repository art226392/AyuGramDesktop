@echo off
chcp 65001 >nul
title AyuGram Fancy (Codex)
set "AYU_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$m='#'+'PS1'; $s=[IO.File]::ReadAllText($env:AYU_SELF,[Text.Encoding]::UTF8); $i=$s.IndexOf($m+'_START'); iex $s.Substring($i)"
echo.
pause
exit /b
#PS1_START
# AYU_FANCY.cmd: ✨ button and Ctrl+Shift+F in the installed AyuGram, formatting by Codex.
# Safe to run again and again: what is already in place is skipped.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch {}
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$Repo     = 'art226392/AyuGramDesktop'
$Ua       = @{ 'User-Agent' = 'AyuFancy-cmd' }
$Work     = Join-Path $env:LOCALAPPDATA 'AyuFancy'
$Utf8     = New-Object System.Text.UTF8Encoding($false)
if ($env:AYU_FANCY_TEST_WORK) { $Work = $env:AYU_FANCY_TEST_WORK }
New-Item -ItemType Directory -Force -Path $Work | Out-Null
try { Start-Transcript -Path (Join-Path $Work 'last_run.log') -Force | Out-Null } catch {}

$Done = New-Object System.Collections.Generic.List[string]
function Say($text, $color = 'Gray') { Write-Host $text -ForegroundColor $color }
function Step($text) { Say "`n== $text" 'Cyan' }
function Good($text) { Say "  OK  $text" 'Green'; $Done.Add($text) }
function Bad($text) { Say "  !!  $text" 'Yellow' }
function Fail($text) {
	Say "`n  XX  $text" 'Red'
	try { Stop-Transcript | Out-Null } catch {}
	exit 1
}
function Quote($arg) {
	if ($arg -match '[\s"]') { return '"' + ($arg -replace '"', '\"') + '"' }
	return $arg
}
function Test-Denied($record) {
	$e = $record.Exception
	while ($e) {
		if ($e -is [UnauthorizedAccessException]) { return $true }
		$e = $e.InnerException
	}
	return $false
}
function Copy-File($from, $to) {
	try {
		Copy-Item -LiteralPath $from -Destination $to -Force
	} catch {
		if (-not (Test-Denied $_)) { throw }
		Copy-Elevated $from $to
	}
}
function Write-Utf8($path, $text) {
	try {
		[IO.File]::WriteAllText($path, $text, $Utf8)
	} catch {
		if (-not (Test-Denied $_)) { throw }
		$tmp = Join-Path $Work ('elevated-' + [IO.Path]::GetFileName($path))
		[IO.File]::WriteAllText($tmp, $text, $Utf8)
		Copy-Elevated $tmp $path
	}
}
# Native tools write warnings to stderr, that must not stop the script.
function Invoke-Native($exe, [string[]]$arguments) {
	$old = $ErrorActionPreference
	$ErrorActionPreference = 'Continue'
	try {
		$text = (& $exe @arguments 2>&1 | ForEach-Object { "$_" }) -join "`n"
		return @{ Code = $LASTEXITCODE; Text = $text.Trim() }
	} catch {
		return @{ Code = -1; Text = "$_" }
	} finally {
		$ErrorActionPreference = $old
	}
}
function Copy-Elevated($from, $to) {
	Say '  Папка защищена, Windows спросит разрешение (Да).' 'Yellow'
	$cmd = "Copy-Item -LiteralPath '" + ($from -replace "'", "''") + "' -Destination '" + ($to -replace "'", "''") + "' -Force"
	$p = Start-Process powershell -Verb RunAs -Wait -PassThru -ArgumentList @(
		'-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $cmd)
	if ($p.ExitCode -ne 0 -or -not (Test-Path -LiteralPath $to)) {
		Fail "Не удалось записать $to"
	}
}
function Get-Text($url) {
	$tmp = Join-Path $Work ('dl-' + [guid]::NewGuid().ToString('N'))
	try {
		Invoke-WebRequest -UseBasicParsing -Headers $Ua -TimeoutSec 60 -Uri $url -OutFile $tmp
		return ([IO.File]::ReadAllText($tmp)).Trim()
	} catch {
		return ''
	} finally {
		Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
	}
}
function Get-Api($path) {
	try {
		return Invoke-RestMethod -UseBasicParsing -Headers $Ua -TimeoutSec 60 -Uri ('https://api.github.com/repos/' + $Repo + $path)
	} catch {
		return $null
	}
}
function Read-Json($path) {
	if (-not (Test-Path -LiteralPath $path)) { return $null }
	try {
		$text = [IO.File]::ReadAllText($path).TrimStart([char]0xFEFF)
		return ($text | ConvertFrom-Json)
	} catch {
		Bad "Не читается $path, сделаю новый (старый в .bak)"
		Copy-Item -LiteralPath $path -Destination ($path + '.bak') -Force -ErrorAction SilentlyContinue
		return $null
	}
}

$AyuFancySource = ''
Say '✨ AyuGram: кнопка «Красиво» у отправки, через Codex' 'Magenta'
Say '   AyuGram не меняется и не перекачивается. Окно всё делает само.' 'DarkGray'

$Config = Join-Path $Work 'ayu_fancy.json'
$current = Read-Json $Config

# 1. Where AyuGram is (only to find the Groq key of the voice feature).
Step 'AyuGram'
$VoiceFiles = New-Object System.Collections.Generic.List[string]
$ayu = Get-Process -Name 'AyuGram' -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1
if ($ayu) {
	$VoiceFiles.Add((Join-Path (Split-Path -Parent $ayu.Path) 'ayu_voice.json'))
	Good ('AyuGram запущен: ' + $ayu.Path)
} else {
	Bad 'AyuGram сейчас не запущен, это не мешает'
}
foreach ($dir in @((Join-Path $env:APPDATA 'AyuGram Desktop'), (Join-Path $env:APPDATA 'AyuGram Desktop\tdata'))) {
	$VoiceFiles.Add((Join-Path $dir 'ayu_voice.json'))
}

# 4. Codex CLI: the one on PATH, else a portable copy from npm (no Node.js).
Step 'Codex'
function Find-NpmCodexExe($shimDir) {
	foreach ($root in @("$shimDir\node_modules\@openai\codex\node_modules\@openai", "$shimDir\node_modules\@openai")) {
		foreach ($tail in @('codex-win32-x64\vendor\x86_64-pc-windows-msvc\bin\codex.exe', 'codex-win32-x64\vendor\x86_64-pc-windows-msvc\codex\codex.exe')) {
			$path = Join-Path $root $tail
			if (Test-Path -LiteralPath $path) { return $path }
		}
	}
	return $null
}
function Test-Codex($exe) {
	if (-not $exe -or -not (Test-Path -LiteralPath $exe)) { return $false }
	$result = Invoke-Native $exe @('--version')
	return ($result.Code -eq 0 -and $result.Text -match 'codex')
}
$Codex = $null
if ($current -and $current.codex_path -and (Test-Codex $current.codex_path)) { $Codex = $current.codex_path }
if (-not $Codex) {
	foreach ($name in @('codex.exe', 'codex.cmd')) {
		$found = Get-Command $name -ErrorAction SilentlyContinue | Select-Object -First 1
		if (-not $found) { continue }
		$path = $found.Source
		if ($path -like '*.cmd') { $path = Find-NpmCodexExe (Split-Path -Parent $path) }
		if (Test-Codex $path) { $Codex = $path; break }
	}
}
$portableRoot = Join-Path $Work 'codex'
$portableExe = Join-Path $portableRoot 'package\vendor\x86_64-pc-windows-msvc\bin\codex.exe'
if (-not $Codex) {
	$tags = Invoke-RestMethod -UseBasicParsing -Headers $Ua -TimeoutSec 60 -Uri 'https://registry.npmjs.org/-/package/@openai/codex/dist-tags'
	$version = $tags.'win32-x64'
	$installed = if (Test-Path -LiteralPath (Join-Path $portableRoot 'version.txt')) { ([IO.File]::ReadAllText((Join-Path $portableRoot 'version.txt'))).Trim() } else { '' }
	if ($installed -eq $version -and (Test-Codex $portableExe)) {
		$Codex = $portableExe
	} else {
		$meta = Invoke-RestMethod -UseBasicParsing -Headers $Ua -TimeoutSec 60 -Uri ('https://registry.npmjs.org/@openai/codex/' + $version)
		$tgz = Join-Path $Work 'codex.tgz'
		Say "  Качаю Codex $version (~160 МБ)…" 'DarkGray'
		try {
			Invoke-WebRequest -UseBasicParsing -Headers $Ua -TimeoutSec 1800 -Uri $meta.dist.tarball -OutFile $tgz
		} catch {
			Fail "Не скачался Codex ($($_.Exception.Message)). Запусти ещё раз."
		}
		$integrity = [string]$meta.dist.integrity
		if ($integrity -like 'sha512-*') {
			$hex = (Get-FileHash -LiteralPath $tgz -Algorithm SHA512).Hash
			$bytes = New-Object byte[] ([int]($hex.Length / 2))
			for ($i = 0; $i -lt $bytes.Length; $i++) { $bytes[$i] = [Convert]::ToByte($hex.Substring($i * 2, 2), 16) }
			if ([Convert]::ToBase64String($bytes) -ne $integrity.Substring(7)) { Fail 'Архив Codex битый. Запусти ещё раз.' }
		}
		$fresh = Join-Path $Work 'codex-new'
		Remove-Item -LiteralPath $fresh -Recurse -Force -ErrorAction SilentlyContinue
		New-Item -ItemType Directory -Force -Path $fresh | Out-Null
		$untar = Invoke-Native 'tar.exe' @('-xzf', $tgz, '-C', $fresh)
		if ($untar.Code -ne 0) { Fail "Не распаковался Codex (tar): $($untar.Text)" }
		Remove-Item -LiteralPath $portableRoot -Recurse -Force -ErrorAction SilentlyContinue
		Move-Item -LiteralPath $fresh -Destination $portableRoot
		[IO.File]::WriteAllText((Join-Path $portableRoot 'version.txt'), $version, $Utf8)
		Remove-Item -LiteralPath $tgz -Force -ErrorAction SilentlyContinue
		if (-not (Test-Codex $portableExe)) { Fail 'Codex не запускается после установки' }
		$Codex = $portableExe
	}
}
$codexVersion = ((Invoke-Native $Codex @('--version')).Text -split "`n" | Where-Object { $_ -match 'codex' } | Select-Object -Last 1)
Good "Codex: $codexVersion"

# 5. ChatGPT login of Codex (the same account works for Codex Desktop).
Step 'Вход Codex в ChatGPT'
$login = Invoke-Native $Codex @('login', 'status')
$status = $login.Text
$loggedIn = ($login.Code -eq 0) -and ($status -notmatch 'Not logged in')
if (-not $loggedIn -and -not $env:AYU_FANCY_TEST_DIR) {
	Say '  Сейчас откроется браузер: войди в ChatGPT. Окно подождёт.' 'Yellow'
	$old = $ErrorActionPreference
	$ErrorActionPreference = 'Continue'
	& $Codex login
	$ErrorActionPreference = $old
	$login = Invoke-Native $Codex @('login', 'status')
	$status = $login.Text
	$loggedIn = ($login.Code -eq 0) -and ($status -notmatch 'Not logged in')
}
if ($loggedIn) {
	Good ('Codex: ' + (($status -split "`n" | Where-Object { $_ -match 'Logged in' } | Select-Object -First 1) -as [string]).Trim())
} else {
	Bad ("Codex не вошёл: " + ($status -split "`n" | Select-Object -Last 1))
}

# 6. Spare engine: Groq key, if there is none yet (optional when Codex works).
Step 'Запасной движок Groq'
$key = ''
if ($current -and $current.key) { $key = [string]$current.key }
if (-not $key) {
	foreach ($voice in $VoiceFiles) {
		$json = Read-Json $voice
		if ($json -and $json.key) { $key = [string]$json.key; break }
	}
}
if (-not $key -and $env:GROQ_API_KEY) { $key = $env:GROQ_API_KEY }
$newKey = ''
if ($key) {
	Good 'Groq: ключ уже есть, будет запасным'
} elseif ($env:AYU_FANCY_TEST_DIR) {
	Bad 'Groq: пропущен (тест)'
} else {
	$ask = if ($loggedIn) { 'Для диктовки (кнопка микрофона) нужен бесплатный ключ Groq, он же запасной для Codex. Нажми G и Enter, чтобы добавить, или просто Enter' } else { 'Без Codex нужен ключ Groq. Нажми G и Enter' }
	$answer = Read-Host "  $ask"
	if ($answer -match '^[gGпП]') {
		Start-Process 'https://console.groq.com/keys'
		for ($try = 0; $try -lt 3 -and -not $newKey; $try++) {
			$secure = Read-Host '  Вставь ключ gsk_… (символы не видны) и Enter' -AsSecureString
			$plain = [Runtime.InteropServices.Marshal]::PtrToStringBSTR([Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)).Trim()
			if ($plain -notmatch '^gsk_[A-Za-z0-9]{20,}$') { Bad 'Это не похоже на ключ Groq (gsk_…)'; continue }
			try {
				$null = Invoke-RestMethod -UseBasicParsing -TimeoutSec 30 -Uri 'https://api.groq.com/openai/v1/models' -Headers @{ Authorization = "Bearer $plain" }
				$newKey = $plain
				Good 'Groq: ключ проверен'
			} catch {
				Bad 'Groq ключ не принял, попробуй ещё раз'
			}
		}
	}
}

# 7. Build AyuFancy.exe right here with csc.exe of .NET Framework 4.
Step 'Собираю AyuFancy (кнопка ✨)'
$csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'
if (-not (Test-Path -LiteralPath $csc)) { $csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework\v4.0.30319\csc.exe' }
if ($env:AYU_FANCY_TEST_CSC) { $csc = $env:AYU_FANCY_TEST_CSC }
if (-not (Test-Path -LiteralPath $csc)) { Fail 'Нет csc.exe (.NET Framework 4). Напиши Claude.' }
$srcDir = Join-Path $Work 'src'
New-Item -ItemType Directory -Force -Path $srcDir | Out-Null
$source = Join-Path $srcDir 'AyuFancy.cs'
[IO.File]::WriteAllBytes($source, [Convert]::FromBase64String($AyuFancySource))
$exe = Join-Path $Work 'AyuFancy.exe'
$newExe = Join-Path $srcDir 'AyuFancy.exe'
Remove-Item -LiteralPath $newExe -Force -ErrorAction SilentlyContinue
$wpf = Join-Path (Split-Path -Parent $csc) 'WPF'
$cscArgs = @('/nologo', '/codepage:65001', '/target:winexe', '/optimize+',
	('/out:' + $newExe), '/r:System.Web.Extensions.dll', '/r:System.Windows.Forms.dll', '/r:System.Drawing.dll')
if (Test-Path -LiteralPath (Join-Path $wpf 'UIAutomationClient.dll')) {
	$cscArgs += @(('/lib:' + $wpf), '/r:UIAutomationClient.dll', '/r:UIAutomationTypes.dll', '/r:WindowsBase.dll')
} elseif ($env:AYU_FANCY_TEST_UIA_STUB) {
	$cscArgs += @($env:AYU_FANCY_TEST_UIA_STUB)
}
$build = Invoke-Native $csc ($cscArgs + @($source))
if ($build.Code -ne 0 -or -not (Test-Path -LiteralPath $newExe)) {
	Say $build.Text 'DarkGray'
	Fail 'AyuFancy не собрался. Пришли Claude текст выше.'
}
Get-Process -Name 'AyuFancy' -ErrorAction SilentlyContinue | Stop-Process -Force
Start-Sleep -Milliseconds 500
Copy-Item -LiteralPath $newExe -Destination $exe -Force
Good 'AyuFancy.exe собран'

# 8. Settings, the user's own fields (button place, style) are kept.
Step 'Настройки'
$settings = [ordered]@{}
if ($current) { foreach ($property in $current.PSObject.Properties) { $settings[$property.Name] = $property.Value } }
if (-not $settings.Contains('enabled')) { $settings['enabled'] = $true }
if (-not $settings.Contains('engine')) { $settings['engine'] = 'auto' }
if (-not $settings.Contains('button')) { $settings['button'] = $true }
$settings['mode'] = 'clean'
if (-not $settings.Contains('dictation')) { $settings['dictation'] = $true }
if (-not $settings.Contains('codex_server')) { $settings['codex_server'] = $true }
if (-not $settings.Contains('on_enter')) { $settings['on_enter'] = $true }
$settings['codex_path'] = $Codex
if ($newKey) { $settings['key'] = $newKey }
elseif ($key -and -not $settings.Contains('key')) { $settings['key'] = $key }
if (Test-Path -LiteralPath $Config) {
	Copy-Item -LiteralPath $Config -Destination ($Config + '.bak') -Force -ErrorAction SilentlyContinue
}
Write-Utf8 $Config (($settings | ConvertTo-Json -Depth 5))
Good "ayu_fancy.json: движок $($settings['engine'])"

# 8b. GPT-6.1 Terra, as deep as fits the 5 s limit: medium, else low,
# else none. GPT-5.6 Terra the same way if this account has no 6.1.
if ($loggedIn -and -not $settings.Contains('codex_model_locked')) {
	Step 'Модель: GPT-6.1 Terra, рассуждение под лимит 5 с'
	$probeIn = Join-Path $Work 'probe_in.txt'
	[IO.File]::WriteAllText($probeIn, 'привет всем созвон в 19:00 не опаздывайте ссылка будет в чате', $Utf8)
	$candidates = @(
		@('gpt-6.1-terra', 'medium'), @('gpt-6.1-terra', 'low'), @('gpt-6.1-terra', 'none'),
		@('gpt-5.6-terra', 'medium'), @('gpt-5.6-terra', 'low'), @('gpt-5.6-terra', 'none'))
	$best = $null
	$missing = @{}
	$oldHome = $env:AYU_FANCY_HOME
	foreach ($candidate in $candidates) {
		if ($missing.ContainsKey($candidate[0])) { continue }
		$probeHome = Join-Path $Work ('probe-' + [guid]::NewGuid().ToString('N'))
		New-Item -ItemType Directory -Force -Path $probeHome | Out-Null
		$probeConfig = [ordered]@{ engine = 'codex'; mode = 'clean'; codex_path = $Codex; codex_model = $candidate[0]; codex_effort = $candidate[1] }
		[IO.File]::WriteAllText((Join-Path $probeHome 'ayu_fancy.json'), ($probeConfig | ConvertTo-Json), $Utf8)
		$probeOut = Join-Path $probeHome 'out.txt'
		$env:AYU_FANCY_HOME = $probeHome
		$probe = Start-Process -FilePath $exe -ArgumentList @('--selftest', (Quote $probeIn), (Quote $probeOut)) -PassThru
		if (-not $probe.WaitForExit(60000)) { try { $probe.Kill() } catch {} }
		$env:AYU_FANCY_HOME = $oldHome
		$report = if (Test-Path -LiteralPath $probeOut) { [IO.File]::ReadAllText($probeOut) } else { '' }
		Remove-Item -LiteralPath $probeHome -Recurse -Force -ErrorAction SilentlyContinue
		if ($probe.ExitCode -eq 0 -and $report -match 'seconds: ([0-9.]+)') {
			$seconds = [double]::Parse($Matches[1], [Globalization.CultureInfo]::InvariantCulture)
			Say ('  {0} {1}: {2:0.0} с' -f $candidate[0], $candidate[1], $seconds)
			if (-not $best -or $seconds -lt $best[2]) { $best = @($candidate[0], $candidate[1], $seconds) }
			if ($seconds -le 4) { $best = @($candidate[0], $candidate[1], $seconds); break }
		} else {
			$why = if ($report -match 'error: (.*)') { $Matches[1].Trim() } else { 'нет ответа' }
			Say ('  {0} {1}: {2}' -f $candidate[0], $candidate[1], $why) 'DarkGray'
			if ($why -match 'model|not supported|does not exist|unknown') { $missing[$candidate[0]] = $true }
		}
	}
	if ($best) {
		$settings['codex_model'] = $best[0]
		$settings['codex_effort'] = $best[1]
		Write-Utf8 $Config (($settings | ConvertTo-Json -Depth 5))
		Good ('Codex: {0} ({1}), {2:0.0} с' -f $best[0], $best[1], $best[2])
		if ($best[2] -gt 4 -and -not ($key -or $newKey)) {
			Bad 'Terra не укладывается в 4 с даже без рассуждения: длинные сообщения будут уходить как есть. Ключ Groq (G при запуске) это страхует.'
		}
	} else {
		Bad 'Terra не ответила'
	}
}

# 9. Formats a real message the same way the button does.
Step 'Проверяю на живом сообщении'
$testIn = Join-Path $Work 'selftest_in.txt'
$testOut = Join-Path $Work 'selftest_out.txt'
[IO.File]::WriteAllText($testIn, 'привет всем, созвон сегодня в 19:00, не опаздывайте. ссылка на встречу будет в чате', $Utf8)
Remove-Item -LiteralPath $testOut -Force -ErrorAction SilentlyContinue
if ($loggedIn -or $key -or $newKey) {
	$selftest = Start-Process -FilePath $exe -ArgumentList @('--selftest', (Quote $testIn), (Quote $testOut)) -PassThru
	if (-not $selftest.WaitForExit(150000)) { try { $selftest.Kill() } catch {} }
	$report = if (Test-Path -LiteralPath $testOut) { [IO.File]::ReadAllText($testOut) } else { '' }
	$lines = @{}
	foreach ($line in ($report -split "`n")) { if ($line -match '^(\w+): ?(.*)$') { $lines[$Matches[1]] = $Matches[2].Trim() } }
	if ($selftest.ExitCode -eq 0 -and $lines['text']) {
		Good ("{0} оформил за {1} с: {2}" -f $lines['engine'], $lines['seconds'], $lines['text'])
		Say ('      разметка: ' + $lines['tags']) 'DarkGray'
	} else {
		Bad ('Не получилось: ' + $lines['error'])
	}
} else {
	Bad 'Проверка пропущена: нет ни входа Codex, ни ключа Groq'
}

# 9b. Dictation: Whisper large-v3 on Groq answers with this key.
Step 'Диктовка (Whisper large-v3)'
if ($settings.Contains('key') -and $settings['key']) {
	$whisperOut = Join-Path $Work 'whisper_test.txt'
	$whisper = Start-Process -FilePath $exe -ArgumentList @('--whisper-test', (Quote $whisperOut)) -PassThru
	if (-not $whisper.WaitForExit(60000)) { try { $whisper.Kill() } catch {} }
	$report = if (Test-Path -LiteralPath $whisperOut) { [IO.File]::ReadAllText($whisperOut) } else { '' }
	if ($whisper.ExitCode -eq 0) {
		Good 'Диктовка: Whisper отвечает'
	} else {
		$why = if ($report -match 'error: (.*)') { $Matches[1].Trim() } else { 'нет ответа' }
		Bad ('Диктовка не работает: ' + $why)
	}
} else {
	Bad 'Диктовка выключится без ключа Groq: запусти меня ещё раз и нажми G'
}

# 10. Autostart and start.
Step 'Автозапуск и запуск'
$startup = [Environment]::GetFolderPath('Startup')
if ($startup -and -not $env:AYU_FANCY_TEST_WORK) {
	$shell = New-Object -ComObject WScript.Shell
	$link = $shell.CreateShortcut((Join-Path $startup 'AyuFancy.lnk'))
	$link.TargetPath = $exe
	$link.WorkingDirectory = $Work
	$link.Description = 'AyuFancy: ✨ кнопка в AyuGram'
	$link.Save()
	Good 'Автозапуск с Windows'
}
if ($env:AYU_FANCY_TEST_WORK) {
	Bad 'Запуск пропущен (тест)'
} else {
	Start-Process -FilePath $exe -WorkingDirectory $Work
	Start-Sleep -Seconds 2
	if (Get-Process -Name 'AyuFancy' -ErrorAction SilentlyContinue) { Good 'AyuFancy работает (фиолетовая F в трее)' } else { Bad 'AyuFancy не запустился' }
}

Say "`n================  ИТОГ  ================" 'Magenta'
foreach ($line in $Done) { Say "  ✔ $line" 'Green' }
Say "`nПроверь в AyuGram:" 'Cyan'
Say '  1. Напиши сообщение, Enter: уйдёт оформленным максимум через 5 с (обычно сразу, оформление готовится, пока печатаешь).'
